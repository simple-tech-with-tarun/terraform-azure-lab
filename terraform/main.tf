terraform {
  required_version = ">= 1.5.0"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~>4.0"
    }
  }
}

provider "azurerm" {
  features {}
}

resource "azurerm_resource_group" "lab" {
  name     = var.resource_group_name
  location = var.resource_group_location
  tags = {
    Owner       = "Tarun"
    AutoDelete  = "Yes"
    Environment = "Dev"
  }
}
